{
  "name": "repandration-mobile",
  "private": true,
  "version": "1.0.0",
  "description": "Rep & Ration native app shell for iPhone and Android (Capacitor), with Apple Health and Health Connect sync.",
  "scripts": {
    "add:android": "cap add android && node scripts/patch-android.mjs",
    "add:ios": "cap add ios && node scripts/patch-ios.mjs",
    "sync": "cap sync",
    "android:debug": "cd android && ./gradlew assembleDebug",
    "android:bundle": "cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capgo/capacitor-health": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0"
  }
}
